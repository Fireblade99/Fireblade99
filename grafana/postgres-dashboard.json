{
  "title": "PostgreSQL — состояние и время отклика",
  "description": "Мониторинг удалённого Postgres. Источники: postgres_exporter и node_exporter на хосте БД, плюс pg-probe рядом с Prometheus для измерения времени отклика снаружи.",
  "tags": [
    "postgresql",
    "database"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Источник данных",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "pg_instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(pgprobe_up, pg_instance)",
        "label": "База",
        "refresh": 1,
        "sort": 1,
        "current": {},
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Состояние",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Доступность",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "pgprobe_up{pg_instance=\"$pg_instance\"}",
          "legendFormat": "up",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ЛЕЖИТ",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ЖИВА",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "1 — база отвечает нашему проберу. 0 — нет. Разрыв в графике означает, что не работал сам мониторинг."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Отклик p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "pg:session_ping:p95{pg_instance=\"$pg_instance\"}",
          "legendFormat": "p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "95-й перцентиль SELECT 1 по уже открытому соединению. Запрос ничего не делает, поэтому это чистая отзывчивость сервера."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Слоты подключений",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "pg:connections:utilization{pg_instance=\"$pg_instance\"}",
          "legendFormat": "занято",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Занято от max_connections. Когда упрётся в 100%, новые клиенты начнут получать отказ, а база при этом останется «живой»."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Диск (макс. занято)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(host:filesystem:used_ratio{pg_instance=\"$pg_instance\"})",
          "legendFormat": "занято",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Самая заполненная файловая система на хосте БД. Переполнение тома останавливает запись в Postgres мгновенно."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Аптайм Postgres",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "pgprobe_postmaster_uptime_seconds{pg_instance=\"$pg_instance\"}",
          "legendFormat": "аптайм",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Резкое падение значения = база перезапускалась."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Транзакций/с",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "pg:transactions:rate{pg_instance=\"$pg_instance\"}",
          "legendFormat": "tps",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "Коммиты плюс откаты. Основной показатель нагрузки."
    },
    {
      "id": 8,
      "type": "row",
      "title": "Время отклика — разложение по составляющим",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Из чего складывается задержка (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "pg:tcp_connect:p95{pg_instance=\"$pg_instance\"}",
          "legendFormat": "1. сеть (TCP)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "pg:connect:p95{pg_instance=\"$pg_instance\"}",
          "legendFormat": "2. + TLS и авторизация",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pgprobe_ping_seconds_bucket{pg_instance=\"$pg_instance\"}[5m])))",
          "legendFormat": "3. запрос по новому соединению",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "pg:session_ping:p95{pg_instance=\"$pg_instance\"}",
          "legendFormat": "4. запрос по готовому соединению",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Главная диагностическая панель. Если растёт только «сеть» — проблема в канале, Postgres ни при чём. Если растёт «TLS и авторизация», а «по готовому соединению»в норме — кончаются слоты подключений или тормозит хендшейк. Если растёт нижняя линия — тормозит сам сервер."
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "История доступности",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "expr": "pgprobe_up{pg_instance=\"$pg_instance\"}",
          "legendFormat": "доступность",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "лежит",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "жива",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "description": "Именно ради этой панели мониторинг вынесен наружу: если бы данные хранились в самой базе, история её простоя не сохранилась бы."
    },
    {
      "id": 11,
      "type": "row",
      "title": "Нагрузка и эффективность",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Подключения по состояниям",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{pg_instance=\"$pg_instance\"})",
          "legendFormat": "{{state}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max(pg_settings_max_connections{pg_instance=\"$pg_instance\"})",
          "legendFormat": "лимит max_connections",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Рост «idle in transaction» — всегда баг приложения: незакрытая транзакция блокирует автовакуум по всей базе."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Попадания в кэш",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "pg:cache:hit_ratio{pg_instance=\"$pg_instance\"}",
          "legendFormat": "hit ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Ниже 95% — база регулярно ходит мимо shared buffers. Разрыв на графике означает «трафика не было», а не «ноль попаданий»: отношение при простое не определено."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Откаты транзакций",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "pg:transactions:rollback_ratio{pg_instance=\"$pg_instance\"}",
          "legendFormat": "доля откатов",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Устойчивый рост доли откатов — обычно ошибки в приложении."
    },
    {
      "id": 15,
      "type": "row",
      "title": "Хост базы данных",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Заполнение файловых систем",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "host:filesystem:used_ratio{pg_instance=\"$pg_instance\"}",
          "legendFormat": "{{mountpoint}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Видно только благодаря node_exporter: изнутри Postgres свободное место на диске недоступно в принципе."
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Доступная память",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 25
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{pg_instance=\"$pg_instance\"}",
          "legendFormat": "доступно",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "node_memory_MemTotal_bytes{pg_instance=\"$pg_instance\"}",
          "legendFormat": "всего",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "При нехватке памяти OOM killer может прибить backend, и база уйдёт в аварийное восстановление."
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Ожидание диска (iowait)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "targets": [
        {
          "expr": "avg by (instance) (rate(node_cpu_seconds_total{pg_instance=\"$pg_instance\",mode=\"iowait\"}[5m]))",
          "legendFormat": "iowait",
          "refId": "A",
