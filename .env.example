# Локальный запуск пробера (для отладки; на Windows это делает
# windows/Install-PgProbe.ps1, и .env не нужен).
#
#   cp .env.example .env && set -a && . ./.env && set +a && python3 probe/probe.py
#
# .env в git не попадает — см. .gitignore.

PGHOST=db.example.com
PGPORT=5432
PGDATABASE=postgres

# Роль из sql/01_monitoring_role.sql. НЕ суперюзер: проберу достаточно
# pg_monitor, и давать ему больше незачем.
PGUSER=monitoring
PGPASSWORD=

# База удалённая, трафик идёт по сети — по умолчанию требуем TLS.
#   require     — шифровать, сертификат не проверять
#   verify-full — шифровать и проверять сертификат и имя хоста (правильнее,
#                 нужен корневой сертификат сервера)
#   disable     — только для доверенной приватной сети
PGSSLMODE=require

PGPROBE_PORT=9899

# 15 секунд — компромисс: достаточно часто, чтобы заметить проблему,
# и достаточно редко, чтобы не создавать нагрузку.
PGPROBE_INTERVAL_SECONDS=15

# Таймаут одной проверки. Должен быть меньше интервала, иначе проверки
# начнут наползать друг на друга.
PGPROBE_TIMEOUT_SECONDS=5

# Доп. метрики (wraparound, блокировки, аптайм, медленные запросы)
# снимаются раз в N циклов: они тяжелее замера отклика и меняются
# медленно. 4 x 15с = раз в минуту.
PGPROBE_GAPS_EVERY_N_CYCLES=4
