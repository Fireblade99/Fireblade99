# ---- web / UI ----
QGW_SECRET_KEY=change-me-to-a-long-random-string
QGW_SESSION_HTTPS_ONLY=false
QGW_BOOTSTRAP_ADMIN_USER=admin
QGW_BOOTSTRAP_ADMIN_PASSWORD=change-me
QGW_TRUST_FORWARDED_FOR=false

# ---- storage ----
# QGW_DATABASE_URL=postgresql+psycopg://user:pass@host/qlik_gateway

# ---- Qlik ----
# mock = built-in fake Qlik for demo; jwt = real Qlik via virtual proxy with JWT
QGW_QLIK_MODE=mock
QGW_QLIK_BASE_URL=https://qlik.company.local/airflowgw
QGW_QLIK_VERIFY_SSL=true
QGW_QLIK_JWT_PRIVATE_KEY_PATH=/app/secrets/qlik_jwt_private.pem
QGW_QLIK_JWT_USER_ID=svc_qlik_gateway
QGW_QLIK_JWT_USER_DIRECTORY=CORP
QGW_QLIK_JWT_USER_ID_ATTR=userId
QGW_QLIK_JWT_USER_DIRECTORY_ATTR=userDirectory
QGW_QLIK_TASK_CUSTOM_PROPERTY=Source
QGW_QLIK_TASK_CUSTOM_PROPERTY_VALUE=Airflow
# engine health of the dedicated nodes (for the resources panel), comma separated
QGW_NODE_HEALTH_URLS=

# ---- coordinator ----
QGW_MAX_CONCURRENT_EXECUTIONS=3
QGW_POLL_INTERVAL_SECONDS=20
QGW_DISPATCH_INTERVAL_SECONDS=3
QGW_CATALOG_SYNC_INTERVAL_SECONDS=600
QGW_LOST_AFTER_SECONDS=900
QGW_AUDIT_RETENTION_DAYS=90
