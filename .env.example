# ---- web / UI ----
QGW_SECRET_KEY=change-me-to-a-long-random-string
QGW_SESSION_HTTPS_ONLY=false
QGW_UI_UTC_OFFSET_HOURS=5
QGW_BOOTSTRAP_ADMIN_USER=admin
QGW_BOOTSTRAP_ADMIN_PASSWORD=change-me
QGW_TRUST_FORWARDED_FOR=false

# ---- UI login with Active Directory (leave QGW_LDAP_URL empty = local accounts only) ----
# The bootstrap admin above stays as the emergency local account (works when AD is down).
# QGW_LDAP_URL=ldaps://dc01.hq.local:636,ldaps://dc02.hq.local:636
# QGW_LDAP_DOMAIN=HQ
# QGW_LDAP_BASE_DN=DC=hq,DC=local
# QGW_LDAP_VERIFY_SSL=system
# QGW_LDAP_START_TLS=false
# QGW_LDAP_ADMIN_GROUPS=QGW-Admins
# QGW_LDAP_VIEWER_GROUPS=QGW-Viewers
# Team groups (role "team", sees only its clients) are set on each client's card in the UI.

# ---- storage ----
# QGW_DATABASE_URL=postgresql+psycopg://user:pass@host/qlik_gateway

# ---- Qlik ----
# mock = built-in fake Qlik for demo; jwt = real Qlik via virtual proxy with JWT
QGW_QLIK_MODE=mock
QGW_QLIK_BASE_URL=https://qlik.company.local/airflowgw
QGW_QLIK_VERIFY_SSL=system
QGW_QLIK_JWT_PRIVATE_KEY_PATH=/app/secrets/qlik_jwt_private.pem
QGW_QLIK_JWT_USER_ID=svc_qlik_gateway
QGW_QLIK_JWT_USER_DIRECTORY=CORP
QGW_QLIK_JWT_USER_ID_ATTR=userId
QGW_QLIK_JWT_USER_DIRECTORY_ATTR=userDirectory
QGW_QLIK_TASK_CUSTOM_PROPERTY=ExternalRun
QGW_QLIK_TASK_CUSTOM_PROPERTY_VALUE=Yes
QGW_QLIK_CLIENT_CUSTOM_PROPERTY=GatewayClient
# engine health of the dedicated nodes (for the resources panel), comma separated
QGW_NODE_HEALTH_URLS=

# ---- coordinator ----
QGW_MAX_CONCURRENT_EXECUTIONS=3
# If the task is already reloading in Qlik and neither the request nor the task/client setting says otherwise:
# reject (409 + link to the active run) | queue (run again after it) | reuse (return the active run)
# QGW_DEFAULT_ON_ACTIVE=reject
# Base URL for links in API answers / Airflow logs; empty = the address the client used
# QGW_PUBLIC_URL=http://qse-app10-wp1:8080
QGW_POLL_INTERVAL_SECONDS=20
QGW_DISPATCH_INTERVAL_SECONDS=3
QGW_CATALOG_SYNC_INTERVAL_SECONDS=600
QGW_LOST_AFTER_SECONDS=900
QGW_AUDIT_RETENTION_DAYS=90
